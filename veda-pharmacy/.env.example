# VEDA Pharmacy — environment configuration
# Copy this file to .env and fill in your values.
# .env is only read on server start (npm start), so restart after editing.

PORT=4600
SESSION_SECRET=change-this-to-a-long-random-string

# ---------- Uploads ----------
# Where prescription photos (Schedule H1/X sales) are stored. Defaults to
# ./uploads/rx next to server.js if unset. The packaged Windows build points
# this at a %PROGRAMDATA% folder instead, same reasoning as DB_DIR — see
# db/connection.js.
# UPLOAD_DIR=

# ---------- Data directory ----------
# Where the SQLite database file lives. Defaults to ./db next to server.js.
# Set by the packaged Windows launcher; you normally don't need this in dev.
# DB_DIR=
