# VEDA Hotel PMS — environment configuration
# Copy this file to .env and fill in your values.
# .env is only read on server start (npm start), so restart after editing.

PORT=4500
SESSION_SECRET=change-this-to-a-long-random-string

# ---------- Email (SMTP) ----------
# Used for "Email Confirmation" and "Email Invoice" buttons.
# Same pattern as the SMTP setup already used in MarkEdge CRM's
# PO acknowledgment emails — reuse those credentials if you have them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Hotel Name <reservations@yourhotel.com>"

# ---------- WhatsApp ----------
# No API/account needed for the built-in "WhatsApp" buttons — they open
# a pre-filled wa.me link in WhatsApp Web/Desktop/Mobile for you to hit Send.
# This just controls what country code gets prefixed to a bare 10-digit
# guest phone number stored without one.
WHATSAPP_COUNTRY_CODE=91
